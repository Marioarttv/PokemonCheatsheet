<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pokemon Team Analyzer</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header h1 {
            color: #333;
            font-size: 2.5rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
        }

        .controls {
            margin-bottom: 30px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            align-items: center;
        }

        .file-input {
            padding: 10px 20px;
            border: 2px dashed #667eea;
            border-radius: 8px;
            background: #f8f9ff;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .file-input:hover {
            border-color: #764ba2;
            background: #f0f2ff;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .pokemon-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            border: 3px solid transparent;
            transition: all 0.3s ease;
        }

        .pokemon-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
        }

        .pokemon-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .pokemon-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: #333;
        }

        .types-container {
            display: flex;
            gap: 8px;
            margin-bottom: 15px;
        }

        .type-badge {
            padding: 6px 12px;
            border-radius: 20px;
            color: white;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .tera-indicator {
            font-size: 0.75rem;
            opacity: 0.9;
        }

        .weaknesses {
            margin-top: 15px;
        }

        .weaknesses h4 {
            color: #d32f2f;
            margin-bottom: 10px;
            font-size: 1.1rem;
        }

        .weakness-types {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .weakness-badge {
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
            background: #ffebee;
            color: #d32f2f;
            border: 1px solid #ffcdd2;
        }

        .no-weaknesses {
            color: #4caf50;
            font-weight: 600;
            font-style: italic;
        }

        .sample-team {
            margin-top: 30px;
            padding: 20px;
            background: #f8f9ff;
            border-radius: 10px;
            border-left: 4px solid #667eea;
        }

        /* Type colors */
        .normal { background: #A8A878; }
        .fighting { background: #C03028; }
        .flying { background: #A890F0; }
        .poison { background: #A040A0; }
        .ground { background: #E0C068; }
        .rock { background: #B8A038; }
        .bug { background: #A8B820; }
        .ghost { background: #705898; }
        .steel { background: #B8B8D0; }
        .fire { background: #F08030; }
        .water { background: #6890F0; }
        .grass { background: #78C850; }
        .electric { background: #F8D030; }
        .psychic { background: #F85888; }
        .ice { background: #98D8D8; }
        .dragon { background: #7038F8; }
        .dark { background: #705848; }
        .fairy { background: #EE99AC; }

        @@media (max-width: 768px) {
            .header h1 {
                font-size: 2rem;
            }

            .team-grid {
                grid-template-columns: 1fr;
            }

            .controls {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🚀 Pokemon Team Weakness Analyzer</h1>
            <p>Competitive Team Analysis Tool</p>
        </div>

        <div class="controls">
            <input type="file" id="teamFile" accept=".json" class="file-input" onchange="loadTeamFromFile(event)">
            <button class="btn" onclick="loadSampleTeam()">Load Sample Team</button>
            <button class="btn" onclick="clearTeam()">Clear Team</button>
        </div>

        <div id="teamContainer" class="team-grid"></div>

        <div class="sample-team">
            <h3>📝 Sample JSON Format:</h3>
            <pre>{
  "teamName": "Sample Team",
  "pokemon": [
    {
      "name": "Garchomp",
      "types": ["Dragon", "Ground"],
      "teraType": "Fire"
    },
    {
      "name": "Rotom-Wash",
      "types": ["Electric", "Water"],
      "teraType": "Water"
    }
  ]
}</pre>
        </div>
    </div>

    <script>
        // Type effectiveness chart
        const typeChart = {
            "Normal": {"Fighting": 2, "Ghost": 0},
            "Fighting": {"Normal": 2, "Flying": 0.5, "Poison": 0.5, "Rock": 2, "Bug": 0.5, "Ghost": 0, "Steel": 2, "Psychic": 0.5, "Ice": 2, "Dark": 2, "Fairy": 0.5},
            "Flying": {"Fighting": 2, "Rock": 0.5, "Bug": 2, "Steel": 0.5, "Electric": 0.5, "Grass": 2, "Ice": 0.5},
            "Poison": {"Poison": 0.5, "Ground": 0.5, "Rock": 0.5, "Ghost": 0.5, "Steel": 0, "Grass": 2, "Fairy": 2},
            "Ground": {"Flying": 0, "Poison": 2, "Rock": 2, "Bug": 0.5, "Steel": 2, "Fire": 2, "Grass": 0.5, "Electric": 2},
            "Rock": {"Fighting": 0.5, "Flying": 2, "Ground": 0.5, "Bug": 2, "Steel": 0.5, "Fire": 2, "Ice": 2},
            "Bug": {"Fighting": 0.5, "Flying": 0.5, "Poison": 0.5, "Ghost": 0.5, "Steel": 0.5, "Fire": 0.5, "Grass": 2, "Psychic": 2, "Dark": 2, "Fairy": 0.5},
            "Ghost": {"Normal": 0, "Ghost": 2, "Psychic": 2, "Dark": 0.5},
            "Steel": {"Rock": 2, "Steel": 0.5, "Fire": 0.5, "Water": 0.5, "Electric": 0.5, "Ice": 2, "Fairy": 2},
            "Fire": {"Rock": 0.5, "Bug": 2, "Steel": 2, "Fire": 0.5, "Water": 0.5, "Grass": 2, "Ice": 2, "Dragon": 0.5},
            "Water": {"Ground": 2, "Rock": 2, "Fire": 2, "Water": 0.5, "Grass": 0.5, "Dragon": 0.5},
            "Grass": {"Flying": 0.5, "Poison": 0.5, "Ground": 2, "Rock": 2, "Bug": 0.5, "Steel": 0.5, "Fire": 0.5, "Water": 2, "Grass": 0.5, "Dragon": 0.5},
            "Electric": {"Flying": 2, "Ground": 0, "Water": 2, "Grass": 0.5, "Electric": 0.5, "Dragon": 0.5},
            "Psychic": {"Fighting": 2, "Poison": 2, "Steel": 0.5, "Psychic": 0.5, "Dark": 0},
            "Ice": {"Flying": 2, "Ground": 2, "Steel": 0.5, "Fire": 0.5, "Water": 0.5, "Grass": 2, "Ice": 0.5, "Dragon": 2},
            "Dragon": {"Steel": 0.5, "Dragon": 2, "Fairy": 0},
            "Dark": {"Fighting": 0.5, "Ghost": 2, "Psychic": 2, "Dark": 0.5, "Fairy": 0.5},
            "Fairy": {"Fighting": 2, "Poison": 0.5, "Steel": 0.5, "Fire": 0.5, "Dragon": 2, "Dark": 2}
        };

        let currentTeam = [];

        function calculateWeaknesses(types, teraType = null) {
            // If terastalized, only consider the tera type
            const defendingTypes = teraType ? [teraType] : types;
            const weaknesses = new Set();

            // Check each attacking type
            for (const attackingType in typeChart) {
                let totalEffectiveness = 1;

                // Calculate combined effectiveness against all defending types
                for (const defendingType of defendingTypes) {
                    const effectiveness = typeChart[attackingType][defendingType] || 1;

                    if (defendingTypes.length === 1) {
                        totalEffectiveness = effectiveness;
                    } else {
                        // For dual types, multiply effectiveness
                        totalEffectiveness *= effectiveness;
                    }
                }

                // If super effective (2x or 4x), it's a weakness
                if (totalEffectiveness >= 2) {
                    weaknesses.add(attackingType);
                }
            }

            return Array.from(weaknesses).sort();
        }

        function createPokemonCard(pokemon) {
            const weaknesses = calculateWeaknesses(pokemon.types, pokemon.teraType);

            return `
                <div class="pokemon-card">
                    <div class="pokemon-header">
                        <div class="pokemon-name">${pokemon.name}</div>
                    </div>

                    <div class="types-container">
                        ${pokemon.types.map(type =>
                            `<span class="type-badge ${type.toLowerCase()}">${type}</span>`
                        ).join('')}
                    </div>

                    ${pokemon.teraType ? `
                        <div class="types-container">
                            <span class="type-badge ${pokemon.teraType.toLowerCase()}" style="border: 2px solid gold;">
                                ✨ Tera: ${pokemon.teraType}
                            </span>
                        </div>
                    ` : ''}

                    <div class="weaknesses">
                        <h4>⚠️ Weaknesses${pokemon.teraType ? ' (When Terastalized)' : ''}:</h4>
                        <div class="weakness-types">
                            ${weaknesses.length > 0 ?
                                weaknesses.map(type =>
                                    `<span class="weakness-badge">${type}</span>`
                                ).join('') :
                                '<span class="no-weaknesses">No weaknesses!</span>'
                            }
                        </div>
                    </div>
                </div>
            `;
        }

        function displayTeam() {
            const container = document.getElementById('teamContainer');

            if (currentTeam.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: #666; font-style: italic;">No team loaded. Upload a JSON file or load the sample team.</p>';
                return;
            }

            container.innerHTML = currentTeam.map(createPokemonCard).join('');
        }

        function loadTeamFromFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const teamData = JSON.parse(e.target.result);
                    currentTeam = teamData.pokemon || [];
                    displayTeam();
                } catch (error) {
                    alert('Error parsing JSON file: ' + error.message);
                }
            };
            reader.readAsText(file);
        }

        function loadSampleTeam() {
            currentTeam = [
                {
                    name: "Garchomp",
                    types: ["Dragon", "Ground"],
                    teraType: "Fire"
                },
                {
                    name: "Rotom-Wash",
                    types: ["Electric", "Water"],
                    teraType: "Water"
                },
                {
                    name: "Amoonguss",
                    types: ["Grass", "Poison"],
                    teraType: "Water"
                },
                {
                    name: "Hatterene",
                    types: ["Psychic", "Fairy"],
                    teraType: "Fairy"
                },
                {
                    name: "Corviknight",
                    types: ["Flying", "Steel"],
                    teraType: "Steel"
                },
                {
                    name: "Dragapult",
                    types: ["Dragon", "Ghost"],
                    teraType: "Ghost"
                }
            ];
            displayTeam();
        }

        function clearTeam() {
            currentTeam = [];
            displayTeam();
            document.getElementById('teamFile').value = '';
        }

        // Initialize with empty state
        displayTeam();
    </script>
</body>
</html>